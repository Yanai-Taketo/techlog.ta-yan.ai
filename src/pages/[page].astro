---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((page) => ({ params: { page: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<Base title={page.data.title} description={page.data.description}>
  <nav aria-label="パンくずリスト" class="text-xs mb-4" style="color: var(--c-sub);">
    <ol class="flex flex-wrap gap-1 list-none m-0 p-0">
      <li><a href="/">ホーム</a><span aria-hidden="true" class="mx-1">›</span></li>
      <li aria-current="page">{page.data.title}</li>
    </ol>
  </nav>
  <article>
    <h1 class="text-2xl sm:text-3xl font-bold leading-snug mb-6">{page.data.title}</h1>
    <div class="article-body">
      <Content />
    </div>
  </article>
</Base>
