---
import { render } from 'astro:content';
import Article from '../layouts/Article.astro';
import { getPublishedPosts } from '../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts(); // 新しい順
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      // posts は新しい順: i+1 が過去(前の記事)、i-1 が未来(次の記事)
      prev: i + 1 < posts.length ? { id: posts[i + 1].id, title: posts[i + 1].data.title } : null,
      next: i > 0 ? { id: posts[i - 1].id, title: posts[i - 1].data.title } : null,
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
---

<Article
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  categories={post.data.categories}
  image={post.data.image}
  headings={headings}
  affiliate={post.data.affiliate}
  prev={prev}
  next={next}
>
  <Content />
</Article>
