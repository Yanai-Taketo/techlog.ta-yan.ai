---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';
import Ad from '../../components/Ad.astro';
import { getPublishedPosts, POSTS_PER_PAGE } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);
  return Array.from({ length: totalPages - 1 }, (_, i) => ({
    params: { num: String(i + 2) },
  }));
}

const { num } = Astro.params;
const current = Number(num);
const posts = await getPublishedPosts();
const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);
const pagePosts = posts.slice((current - 1) * POSTS_PER_PAGE, current * POSTS_PER_PAGE);
---

<Base title={`新着記事 (${current}ページ目)`}>
  <h1 class="text-xl font-bold mb-2 pb-2 border-b-2" style="border-color: var(--c-primary);">
    新着記事 <span class="text-sm font-normal">({current} / {totalPages} ページ)</span>
  </h1>
  <div>
    {pagePosts.map((post) => <PostCard post={post} />)}
  </div>
  <Ad unit="4159024247" />
  <Pagination current={current} total={totalPages} basePath="/" />
</Base>
