---
interface Props {
  name: string;
}
const { name } = Astro.props;
---

<a
  href={`/category/${name}/`}
  class="inline-block no-underline text-xs font-medium rounded-full px-3 py-0.5 border hover:underline"
  style="color: var(--c-primary); background: var(--c-primary-bg); border-color: var(--c-primary);"
  >{name}</a
>
