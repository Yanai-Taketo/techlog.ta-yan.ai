{
  // Cloudflare Workers(静的アセット)設定
  // ダッシュボードの Workers & Pages からGitHub連携でデプロイする場合もこの設定が使われます
  "name": "techlog-ta-yan-ai",
  "compatibility_date": "2026-08-01",
  // *.workers.dev での配信を無効化(本番は techlog.ta-yan.ai のみ。重複配信を防ぐ)
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
